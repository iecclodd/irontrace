{
  "dataset": {
    "name": "Condition monitoring of hydraulic systems",
    "id": 447,
    "doi": "10.24432/C5CW21",
    "url": "https://archive.ics.uci.edu/dataset/447/condition+monitoring+of+hydraulic+systems",
    "citation": "Helwig, N., Pignanelli, E., & Schütze, A. (2015). Condition monitoring of hydraulic systems [Dataset]. UCI Machine Learning Repository. https://doi.org/10.24432/C5CW21",
    "license": "CC BY 4.0"
  },
  "target": "internal_pump_leakage",
  "labels": ["No leakage", "Weak leakage", "Severe leakage"],
  "cost_note": "Simulated scenario units, not measured industrial costs.",
  "statistics": ["mean", "std", "min", "max", "slope"],
  "panels": [
    {"id": "initial", "name": "Initially observed temperature", "sensors": ["TS1"], "cost": 0, "features": ["TS1__mean", "TS1__std", "TS1__min", "TS1__max", "TS1__slope"]},
    {"id": "pressure", "name": "Pressure", "sensors": ["PS1", "PS2", "PS3", "PS4", "PS5", "PS6"], "cost": 4, "features": ["PS1__mean", "PS1__std", "PS1__min", "PS1__max", "PS1__slope", "PS2__mean", "PS2__std", "PS2__min", "PS2__max", "PS2__slope", "PS3__mean", "PS3__std", "PS3__min", "PS3__max", "PS3__slope", "PS4__mean", "PS4__std", "PS4__min", "PS4__max", "PS4__slope", "PS5__mean", "PS5__std", "PS5__min", "PS5__max", "PS5__slope", "PS6__mean", "PS6__std", "PS6__min", "PS6__max", "PS6__slope"]},
    {"id": "flow", "name": "Flow", "sensors": ["FS1", "FS2"], "cost": 3, "features": ["FS1__mean", "FS1__std", "FS1__min", "FS1__max", "FS1__slope", "FS2__mean", "FS2__std", "FS2__min", "FS2__max", "FS2__slope"]},
    {"id": "vibration", "name": "Vibration", "sensors": ["VS1"], "cost": 1, "features": ["VS1__mean", "VS1__std", "VS1__min", "VS1__max", "VS1__slope"]},
    {"id": "power", "name": "Electrical power", "sensors": ["EPS1"], "cost": 2, "features": ["EPS1__mean", "EPS1__std", "EPS1__min", "EPS1__max", "EPS1__slope"]},
    {"id": "temperature", "name": "Additional temperatures", "sensors": ["TS2", "TS3", "TS4"], "cost": 1, "features": ["TS2__mean", "TS2__std", "TS2__min", "TS2__max", "TS2__slope", "TS3__mean", "TS3__std", "TS3__min", "TS3__max", "TS3__slope", "TS4__mean", "TS4__std", "TS4__min", "TS4__max", "TS4__slope"]}
  ]
}
